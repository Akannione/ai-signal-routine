# Copy this file to config/local.env and fill in your real values.

# Where the daily iMessage digest should go.
IMESSAGE_RECIPIENT=+15555550123

# auto tries direct Messages sending first, then GUI fallback.
IMESSAGE_SEND_MODE=auto

# Daily local send time for launchd scheduling.
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0

# Optional custom label for the macOS LaunchAgent.
LAUNCHD_LABEL=com.akannione.ai-signal-routine.daily

# Optional GitHub token for higher API limits on repo and release tracking.
# GITHUB_TOKEN=

# Optional delivery settings for the other digest channels.
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_TO=
# SMTP_USERNAME=
# SMTP_PASSWORD=
